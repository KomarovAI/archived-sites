document.addEventListener('DOMContentLoaded',function(){const modal=document.getElementById('review-modal');const modalTitle=document.getElementById('modal-review-title');const modalContent=document.getElementById('modal-review-content');const modalReviewerName=document.getElementById('modal-reviewer-name-text');const modalClose=document.querySelector('.review-modal-close');const readMoreButtons=document.querySelectorAll('.review-read-more-btn');readMoreButtons.forEach(button=>{button.addEventListener('click',function(){const reviewTitle=this.getAttribute('data-review-title');const reviewContent=this.getAttribute('data-review-content');const reviewerName=this.getAttribute('data-reviewer-name');modalTitle.textContent=reviewTitle;modalContent.innerHTML=reviewContent;modalReviewerName.textContent='- '+reviewerName;modal.classList.add('active');document.body.style.overflow='hidden'})});modalClose.addEventListener('click',function(){closeModal()});modal.addEventListener('click',function(e){if(e.target===modal){closeModal()}});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&modal.classList.contains('active')){closeModal()}});function closeModal(){modal.classList.remove('active');document.body.style.overflow=''}})